import { NextRequest, NextResponse } from 'next/server';
import { groqRequest } from '../../../lib/studyai';

export const maxDuration = 20;

export async function POST(request: NextRequest) {
  try {
    const body = await request.json();
    const {
      pregunta,
      respuestaCorrecta,
      respuestaUsuario,
      contextoMaterial,
      tipoPregunta,
      sourcePage,
      sourceMaterial,
    } = body;

    const answer = String(respuestaUsuario || '').trim().toLowerCase();

    if (!answer || ['nose', 'no se', 'no sé', 'idk', 'xd', 'aw', 'nose aw'].includes(answer)) {
      return NextResponse.json({
        success: true,
        resultado: {
          nivel: 'incorrecta',
          porcentaje: 5,
          analisis: 'Tu respuesta no muestra comprensión del tema.',
          respuestaCorrecta,
          explicacion: 'La respuesta no contiene una idea verificable relacionada con la pregunta.',
          consejo: 'Responde usando una idea concreta del material.'
        }
      });
    }

    const context = String(contextoMaterial || '').slice(0, 9000);

    const systemPrompt = `
Eres un profesor estricto y justo.

Evalúa SOLO con base en:
1. El material fuente.
2. La pregunta.
3. La respuesta correcta esperada.
4. La respuesta del estudiante.

Reglas:
- Si el material contradice la respuesta esperada, prioriza el material.
- No uses conocimiento externo.
- No inventes datos.
- No regales 60%.
- Si la respuesta es exacta o claramente equivalente: 90-100.
- Si usa sinónimo correcto: 80-95.
- Si tiene idea parcial real: 50-74.
- Si está relacionada pero incorrecta: 20-49.
- Si no tiene contenido útil: 0-19.

Devuelve SOLO JSON:
{
"nivel":"correcta|medio_correcta|incorrecta",
"porcentaje":0,
"analisis":"",
"respuestaCorrecta":"",
"explicacion":"",
"consejo":""
}
`;

    const resultado = await groqRequest(async (client, model) => {
      const r = await client.chat.completions.create({
        model: model('llama-3.3-70b-versatile'),
        messages: [
          { role: 'system', content: systemPrompt },
          {
            role: 'user',
            content: `TIPO DE PREGUNTA:
${tipoPregunta || ''}

PÁGINA FUENTE:
${sourcePage || ''}

MATERIAL FUENTE:
${context}

PREGUNTA:
${pregunta}

RESPUESTA CORRECTA ESPERADA:
${respuestaCorrecta}

RESPUESTA DEL ESTUDIANTE:
${respuestaUsuario}`
          },
        ],
        temperature: 0.1,
        max_tokens: 750,
      });

      const text = r.choices[0]?.message?.content || '{}';
      const match = text.match(/\{[\s\S]*\}/);
      return JSON.parse(match ? match[0] : text);
    });

    return NextResponse.json({ success: true, resultado });
  } catch {
    return NextResponse.json({
      success: true,
      resultado: {
        nivel: 'incorrecta',
        porcentaje: 10,
        analisis: 'No se pudo evaluar bien la respuesta.',
        respuestaCorrecta: '',
        explicacion: '',
        consejo: ''
      }
    });
  }
}
